# Copia questo file in .env e imposta i valori reali.
# Il file .env contiene segreti e NON va committato nel repo.

# Token dell'API locale di GoodLinks (Impostazioni -> API, richiede GoodLinks 3.2+)
GOODLINKS_TOKEN="il-tuo-token-goodlinks"

# Access token Mastodon (Preferences -> Development sulla propria istanza)
MASTODON_TOKEN="il-tuo-token-mastodon"

# Template del post Mastodon. Placeholder: {title}, {notes}, {link}.
# {notes} = prima nota (highlight più vecchio) presa sull'articolo in GoodLinks.
MASTODON_MESSAGE_TEMPLATE="{title}
{link}

{notes}

#news #pensieriincodice"

# Token del bot Telegram (da @BotFather)
TELEGRAM_BOT_API_KEY="123456:ABC-il-tuo-token-bot"

# Chat ID separati da virgola: lo stesso articolo viene inviato a tutti i gruppi
TELEGRAM_CHAT_IDS="-1001234567890,-1009876543210"

# Template del messaggio Telegram (MarkdownV2). Placeholder: {title}, {notes}, {link}.
# {notes} = prima nota (highlight più vecchio) presa sull'articolo in GoodLinks.
TELEGRAM_MESSAGE_TEMPLATE="\#news \#link

*{title}*

[Consulta la fonte originale]({link})

{notes}"

# Repo del blog Hugo (owner/repo su GitHub): i post vengono creati come commit
# via API in content/blog/, e il commit fa scattare la CI di build+deploy.
# Commenta BLOG_REPO per mettere in pausa l'output Hugo (gli altri output
# continuano a funzionare).
BLOG_REPO="valeriogalano/pensieriincodice-website"

# PAT GitHub con permesso di scrittura sul repo del blog
BLOG_REPO_TOKEN="ghp_il-tuo-token"
